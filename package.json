{
  "name": "researchflow",
  "version": "1.0.0",
  "private": true,
  "description": "ResearchFlow — Student Project Management, Collaboration, Documentation and Academic Review Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
